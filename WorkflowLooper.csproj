<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Workflow Looper</AssemblyName>
    <RootNamespace>WorkflowLooper</RootNamespace>
    <Version>5.0.12</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\branding\workflow-looper.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <EmbeddedResource Include="assets\vision\cast-ready.png" LogicalName="WorkflowLooper.Vision.CastReady.png" />
    <EmbeddedResource Include="assets\vision\collect-ready.png" LogicalName="WorkflowLooper.Vision.CollectReady.png" />
    <EmbeddedResource Include="assets\vision\catch-card.png" LogicalName="WorkflowLooper.Vision.CatchCard.png" />
  </ItemGroup>
</Project>
