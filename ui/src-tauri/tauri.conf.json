{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Workflow Looper",
  "version": "0.1.0",
  "identifier": "com.blazzer.workflow-looper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Workflow Looper",
      "width": 1180,
      "height": 760,
      "minWidth": 760,
      "minHeight": 620,
      "decorations": false,
      "center": true
    }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' asset: data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../../assets/branding/workflow-looper.ico"],
    "resources": ["resources/engine/Workflow Looper.exe"],
    "windows": { "webviewInstallMode": { "type": "embedBootstrapper" } }
  }
}
