<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseSystemDrawing>true</UseSystemDrawing>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>CuePilot</AssemblyName>
    <RootNamespace>CuePilot</RootNamespace>
    <Version>5.1.0</Version>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\branding\cuepilot.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <Compile Remove="tests\**\*.cs" />
    <EmbeddedResource Include="assets\vision\cast-ready.png" LogicalName="CuePilot.Vision.CastReady.png" />
    <EmbeddedResource Include="assets\vision\collect-ready.png" LogicalName="CuePilot.Vision.CollectReady.png" />
    <EmbeddedResource Include="assets\vision\catch-card.png" LogicalName="CuePilot.Vision.CatchCard.png" />
    <EmbeddedResource Include="assets\vision\tension-ready.png" LogicalName="CuePilot.Vision.TensionReady.png" />
  </ItemGroup>
</Project>
